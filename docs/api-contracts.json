{
  "uploads": {
    "path": "/api/uploads",
    "method": "POST",
    "description": "Upload a single answer recording with metadata.",
    "request": {
      "contentType": "multipart/form-data",
      "fields": {
        "interview_id": "string",
        "question_id": "string",
        "user_id": "string",
        "question_text": "string",
        "attempt": "number",
        "started_at": "RFC3339 timestamp",
        "ended_at": "RFC3339 timestamp",
        "language_hint": "string (optional)",
        "video": "binary (webm/mp4)",
        "audio": "binary (optional if video contains audio)"
      }
    },
    "response": {
      "status": 201,
      "body": {
        "upload_id": "string",
        "storage_path": "string",
        "status": "queued",
        "message": "Upload accepted"
      }
    }
  },
  "transcripts": {
    "path": "/api/transcripts",
    "method": "POST",
    "description": "Create or update a transcript for an uploaded answer.",
    "request": {
      "contentType": "application/json",
      "body": {
        "upload_id": "string",
        "language": "string",
        "segments": [
          {
            "start_ms": 0,
            "end_ms": 1200,
            "text": "Uh, I think...",
            "confidence": 0.87,
            "language": "en",
            "is_filler": true
          }
        ],
        "raw_text": "string",
        "pause_count": 3,
        "filler_count": 5,
        "switches": [
          {
            "from": "en",
            "to": "hi",
            "at_ms": 3500
          }
        ]
      }
    },
    "response": {
      "status": 200,
      "body": {
        "transcript_id": "string",
        "status": "stored"
      }
    }
  },
  "results": {
    "path": "/api/results",
    "method": "POST",
    "description": "Submit scoring results for a completed interview.",
    "request": {
      "contentType": "application/json",
      "body": {
        "interview_id": "string",
        "user_id": "string",
        "overall_score": 0.0,
        "dimensions": {
          "clarity": 0.0,
          "fluency": 0.0,
          "confidence": 0.0
        },
        "answer_scores": [
          {
            "question_id": "string",
            "score": 0.0,
            "notes": "string"
          }
        ]
      }
    },
    "response": {
      "status": 200,
      "body": {
        "result_id": "string",
        "status": "stored"
      }
    }
  },
  "dashboard": {
    "path": "/api/dashboard",
    "method": "GET",
    "description": "Fetch aggregated dashboard metrics.",
    "request": {
      "query": {
        "from": "RFC3339 timestamp",
        "to": "RFC3339 timestamp",
        "group_by": "day|week|month"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "interviews": 0,
        "average_score": 0.0,
        "language_mix": {
          "en": 0.0,
          "hi": 0.0
        },
        "filler_rate": 0.0,
        "scores_over_time": [
          {
            "period": "2024-01",
            "average_score": 0.0
          }
        ]
      }
    }
  }
}
